---
import '../styles/global.css';

const {
  title = 'William Liu',
  description = '个人博客，记录技术学习、生活观察和长期思考。'
} = Astro.props;

const pageTitle = title === 'William Liu' ? title : `${title} | William Liu`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">William Liu</a>
      <nav aria-label="主导航">
        <a href="/">首页</a>
        <a href="/blog">文章</a>
        <a href="/about">关于</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} William Liu</span>
    </footer>
  </body>
</html>
