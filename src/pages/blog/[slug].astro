---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: {
      slug: post.id
        .replace(/^\d{4}-\d{1,2}-\d{1,2}-/, '')
        .replace(/\.mdx?$/, '')
    },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function dateValue(value) {
  if (!value) return 0;
  if (value instanceof Date) return value.getTime();
  const parsed = new Date(String(value).replace(' +0800', '+08:00'));
  return Number.isNaN(parsed.getTime()) ? 0 : parsed.getTime();
}

function formatDate(value) {
  const time = dateValue(value);
  if (!time) return '未注明日期';
  return new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit'
  }).format(new Date(time));
}

function categoryOf(frontmatter) {
  const value = frontmatter.categories ?? frontmatter.category;
  return Array.isArray(value) ? value.join(' / ') : value || '未分类';
}
---

<BaseLayout title={post.data.title} description={post.data.excerpt || post.data.title}>
  <article class="article">
    <header>
      <p class="eyebrow">{categoryOf(post.data)}</p>
      <h1>{post.data.title}</h1>
      <div class="meta">
        <span>{formatDate(post.data.date)}</span>
      </div>
    </header>
    <Content />
  </article>
</BaseLayout>
