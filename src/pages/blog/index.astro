---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

function slugFromId(id) {
  return id
    .replace(/^\d{4}-\d{1,2}-\d{1,2}-/, '')
    .replace(/\.mdx?$/, '');
}

function dateValue(value) {
  if (!value) return 0;
  if (value instanceof Date) return value.getTime();
  const parsed = new Date(String(value).replace(' +0800', '+08:00'));
  return Number.isNaN(parsed.getTime()) ? 0 : parsed.getTime();
}

function formatDate(value) {
  const time = dateValue(value);
  if (!time) return '未注明日期';
  return new Intl.DateTimeFormat('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit'
  }).format(new Date(time));
}

function categoryOf(frontmatter) {
  const value = frontmatter.categories ?? frontmatter.category;
  return Array.isArray(value) ? value.join(' / ') : value || '未分类';
}

const posts = (await getCollection('blog'))
  .map((post) => ({
    title: post.data.title,
    date: post.data.date,
    category: categoryOf(post.data),
    slug: slugFromId(post.id)
  }))
  .sort((a, b) => dateValue(b.date) - dateValue(a.date));
---

<BaseLayout title="文章">
  <section class="intro">
    <p class="eyebrow">Archive</p>
    <h1>文章</h1>
    <p class="lead">旧 Jekyll 文章已复制到 Astro 内容目录，后续可以继续用 Markdown 或 MDX 写作。</p>
  </section>

  <ol class="post-list">
    {posts.map((post) => (
      <li class="post-item">
        <a href={`/blog/${post.slug}`}>{post.title}</a>
        <div class="meta">
          <span>{formatDate(post.date)}</span>
          <span>{post.category}</span>
        </div>
      </li>
    ))}
  </ol>
</BaseLayout>
